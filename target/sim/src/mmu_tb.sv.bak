`timescale 1ns / 1ps

/** @file cpu_tb.v
 *  @brief Test bench for MMU Basic
 *
 *  @author Juan C. Rodriguez (jrodrig9)
 *  @copyright Barcelona Supercomputing Center. All rights reserved.
 *  @bug None.
 *  @doc 
 */

module mmu_tb();

    import mmu_pkg::*;

    `include "axi/assign.svh"
    `include "axi/typedef.svh"
    `include "mmu/typedef.svh"

    localparam mmu_cfg_t Cfg = DefaultCfg;
    `MMU_TYPEDEF_ALL(, Cfg) 

    integer      fd;
    reg          CLK;
    reg          RESET;
    string      preload_elf;

    reg    [3:0] axi_gpio_i;
    wire   [3:0] axi_gpio_o;
    wire   [3:0] axi_gpio_en_o;
    reg          axi_uart_rx_i;
    wire         axi_uart_tx_o;
    

    // Generate indices and get maps for all ports
    localparam axi_in_t   AxiIn   = gen_axi_in(Cfg);
    localparam axi_out_t  AxiOut  = gen_axi_out(Cfg);

    // Connectivity of Xbar
    axi_mst_req_t [AxiIn.num_in-1:0]    axi_in_req;
    axi_mst_rsp_t [AxiIn.num_in-1:0]    axi_in_rsp;
    axi_slv_req_t [AxiOut.num_out-1:0]  axi_out_req;
    axi_slv_rsp_t [AxiOut.num_out-1:0]  axi_out_rsp;

    // Define needed parameters
    localparam int unsigned AxiStrbWidth  = Cfg.AxiDataWidth / 8;
    localparam int unsigned AxiSlvIdWidth = Cfg.AxiMstIdWidth + $clog2(AxiIn.num_in);

    // Type for address map entries
    typedef struct packed {
        logic [$bits(aw_bt)-1:0] idx;
        addr_t start_addr;
        addr_t end_addr;
    } addr_rule_t;

    // Generate address map
    function automatic addr_rule_t [AxiOut.num_rules-1:0] gen_axi_map();
        addr_rule_t [AxiOut.num_rules-1:0] ret;
        for (int i = 0; i < AxiOut.num_rules; ++i)
        ret[i] = '{idx: AxiOut.map[i].idx,
            start_addr: AxiOut.map[i].start, end_addr: AxiOut.map[i].pte};
        return ret;
    endfunction

    localparam addr_rule_t [AxiOut.num_rules-1:0] AxiMap = gen_axi_map();

    logic ctrl_en;
    logic ctrl_op;
    logic [63:0] ctrl_addr;
    logic [63:0] ctrl_write_data;
    logic [63:0] ctrl_read_data;
    logic        ctrl_ready;

   ////////////////////
    // AXI CONTROLLER //
    ///////////////////

   axi_controller
   #(
       .hartid(0),
       .ADDR_WIDTH(Cfg.AddrWidth), 
       .DATA_WIDTH(Cfg.AxiDataWidth), 
       .axi_mst_rsp_t(axi_mst_rsp_t),
       .axi_mst_req_t(axi_mst_req_t) 
   ) u_axi_controller(
       .clk_i(CLK),
       .reset_i(RESET),
       .stall_i(1'b0),

       .cpu_en_i(ctrl_en),
       .cpu_op_i(ctrl_op),
       .cpu_address_i(ctrl_addr),
       .cpu_write_data_i(ctrl_write_data),

       .slave_to_cpu_i(axi_in_rsp[AxiIn.cores[0]]),
       .cpu_to_slave_o(axi_in_req[AxiIn.cores[0]]),

       .axi_cpu_read_data_o(ctrl_read_data),
       .axi_cpu_status_o(),
       .axi_cpu_exeption_o(),
       .axi_cpu_ready_o(ctrl_ready)
   );

    ////////////////
    //  AXI Xbar  //
    ////////////////

    // Configure AXI Xbar
    localparam axi_pkg::xbar_cfg_t AxiXbarCfg = '{
        NoSlvPorts:         AxiIn.num_in,
        NoMstPorts:         AxiOut.num_out,
        MaxMstTrans:        Cfg.AxiMaxMstTrans,
        MaxSlvTrans:        Cfg.AxiMaxSlvTrans,
        FallThrough:        0,
        LatencyMode:        axi_pkg::CUT_ALL_PORTS,
        PipelineStages:     0,
        AxiIdWidthSlvPorts: Cfg.AxiMstIdWidth,
        AxiIdUsedSlvPorts:  Cfg.AxiMstIdWidth,
        UniqueIds:          0,
        AxiAddrWidth:       Cfg.AddrWidth,
        AxiDataWidth:       Cfg.AxiDataWidth,
        NoAddrRules:        AxiOut.num_rules
    };

    axi_xbar #(
        .Cfg            ( AxiXbarCfg ),
        .ATOPs          ( 1  ),
        .Connectivity   ( '1 ),
        .slv_aw_chan_t  ( axi_mst_aw_chan_t ),
        .mst_aw_chan_t  ( axi_slv_aw_chan_t ),
        .w_chan_t       ( axi_mst_w_chan_t  ),
        .slv_b_chan_t   ( axi_mst_b_chan_t  ),
        .mst_b_chan_t   ( axi_slv_b_chan_t  ),
        .slv_ar_chan_t  ( axi_mst_ar_chan_t ),
        .mst_ar_chan_t  ( axi_slv_ar_chan_t ),
        .slv_r_chan_t   ( axi_mst_r_chan_t  ),
        .mst_r_chan_t   ( axi_slv_r_chan_t  ),
        .slv_req_t      ( axi_mst_req_t ),
        .slv_resp_t     ( axi_mst_rsp_t ),
        .mst_req_t      ( axi_slv_req_t ),
        .mst_resp_t     ( axi_slv_rsp_t ),
        .rule_t         ( addr_rule_t )
    ) i_axi_xbar (
        .clk_i( CLK   ),
        .rst_ni( RESET),
        .test_i                 (),
        .slv_ports_req_i        ( axi_in_req ),
        .slv_ports_resp_o       ( axi_in_rsp ),
        .mst_ports_req_o        ( axi_out_req ),
        .mst_ports_resp_i       ( axi_out_rsp ),
        .addr_map_i             ( AxiMap ),
        .en_default_mst_port_i  ( '0 ),
        .default_mst_port_i     ( '0 )
    );

    ////////////
    //  DRAM  //
    ////////////

    localparam time          ClkPeriodSys      = 20ns; //30ns
    localparam real          TAppl             = 0.1;
    localparam real          TTest             = 0.9;
  
    axi_sim_mem #(
        .AddrWidth          ( Cfg.AddrWidth    ),
        .DataWidth          ( Cfg.AxiDataWidth ),
        .IdWidth            ( AxiSlvIdWidth ),
        .UserWidth          ( Cfg.AxiUserWidth ),
        .axi_req_t          ( axi_slv_req_t ),
        .axi_rsp_t          ( axi_slv_rsp_t ),
        .WarnUninitialized  ( 0 ),
        .ClearErrOnAccess   ( 1 ),
        .ApplDelay          ( ClkPeriodSys * TAppl ),
        .AcqDelay           ( ClkPeriodSys * TTest )
    ) i_dram_sim_mem (
        .clk_i              ( CLK   ),
        .rst_ni             ( RESET ),
        .axi_req_i          ( axi_out_req[AxiOut.ram] ),
        .axi_rsp_o          ( axi_out_rsp[AxiOut.ram] ),
        .mon_w_valid_o      ( ),
        .mon_w_addr_o       ( ),
        .mon_w_data_o       ( ),
        .mon_w_id_o         ( ),
        .mon_w_user_o       ( ),
        .mon_w_beat_count_o ( ),
        .mon_w_last_o       ( ),
        .mon_r_valid_o      ( ),
        .mon_r_addr_o       ( ),
        .mon_r_data_o       ( ),
        .mon_r_id_o         ( ),
        .mon_r_user_o       ( ),
        .mon_r_beat_count_o ( ),
        .mon_r_last_o       ( )
    );

    ////////////
    //  GPIO  //
    ////////////

    axi_gpio #(
        .GPIO_DEPTH          ( 4                ),
        .GPIO_WIDTH          ( 4                ),
        .axi_slv_rsp_t       ( axi_slv_rsp_t    ),
        .axi_slv_req_t       ( axi_slv_req_t    )
    ) u_axi_gpio (
        .clk_i              ( CLK               ),
        .reset_i            ( RESET             ),
        .cpu_to_slave_i     ( axi_out_req[AxiOut.gpio] ),
        .slave_to_cpu_o     ( axi_out_rsp[AxiOut.gpio] ),
        .gpio_i             ( axi_gpio_i               ),
        .gpio_o             ( axi_gpio_o               ),
        .gpio_en_o          ( axi_gpio_en_o            ),
        .gpio_irq_o         (                          )   
    );

    ////////////
    //  UART  //
    ////////////

    axi_uart #(
        .SYSTEM_CLOCK_HZ     ( 50000000        ), //38
        .axi_slv_rsp_t       ( axi_slv_rsp_t    ),
        .axi_slv_req_t       ( axi_slv_req_t    )
    ) u_axi_uart (
        .clk_i              ( CLK               ),
        .reset_i            ( RESET             ),
        .cpu_to_slave_i     ( axi_out_req[AxiOut.uart] ),
        .slave_to_cpu_o     ( axi_out_rsp[AxiOut.uart] ),
        .uart_rx_i          ( axi_uart_rx_i            ),
        .uart_tx_o          ( axi_uart_tx_o            ),
        .uart_irq_o         (                          )  
    );



    ///////////////////////////////
    //  UART_SIMULATE_FUNCTIONS  //
    //////////////////////////////

    ///////////
    //  DPI  //
    ///////////

    import "DPI-C" function byte read_elf(input string filename);
    import "DPI-C" function byte get_entry(output longint entry);
    import "DPI-C" function byte get_section(output longint address, output longint len);
    import "DPI-C" context function byte read_section(input longint address, inout byte buffer[], input longint len);

    typedef bit [ 7:0] byte_bt;

    localparam time    UartBaudPeriod = 500ns*1000*1000/9600; // 2631 | 1232
    localparam int unsigned  UartBurstBytes    = 256;
    localparam integer UartParityEna = 1;

    localparam byte_bt UartDebugCmdRead  = 'h11;
    localparam byte_bt UartDebugCmdWrite = 'h12;
    localparam byte_bt UartDebugCmdExec  = 'h13;
    localparam byte_bt UartDebugAck      = 'h06;
    localparam byte_bt UartDebugEot      = 'h04;
    localparam byte_bt UartDebugEoc      = 'h14;

    byte_bt uart_boot_byte;
    logic   uart_reading_byte; 
    logic   uart_boot_ena;
    logic   uart_boot_eoc;


    
    initial 
    begin
      axi_uart_rx_i           = 1;
      uart_reading_byte       = 0;
    end

    task wait_for_reset;
        @(posedge RESET);
        @(posedge CLK);
    endtask
  
    task automatic uart_read_byte(output byte_bt bite);
        // Start bit
        @(negedge axi_uart_tx_o);
        uart_reading_byte = 1;
        #(UartBaudPeriod/2);
        // 8-bit byte
        for (int i = 0; i < 8; i++) begin
        #UartBaudPeriod bite[i] = axi_uart_tx_o;
        end
        // Parity bit
        if(UartParityEna) begin
        bit parity;
        #UartBaudPeriod parity = axi_uart_tx_o;
        if(parity ^ (^bite))
            $error("[UART] - Parity error detected!");
        end
        // Stop bit
        #UartBaudPeriod;
        //$display("[UART] bite: %h", bite);
        uart_reading_byte=0;
    endtask

    task automatic uart_write_byte(input byte_bt bite);
        // Start bit
        axi_uart_rx_i = 1'b0;
        // 8-bit byte
        for (int i = 0; i < 8; i++)
        #UartBaudPeriod axi_uart_rx_i = bite[i];
        // Parity bit
        if (UartParityEna)
        #UartBaudPeriod axi_uart_rx_i = (^bite);
        // Stop bit
        #UartBaudPeriod axi_uart_rx_i = 1'b1;
        #UartBaudPeriod;
    endtask

    task automatic uart_boot_scoop(output byte_bt bite);
        // Assert our intention to scoop the next received byte
        uart_boot_ena = 1;
        // Wait until read task notifies us a scooped byte is available
        @(negedge uart_boot_ena);
        // Grab scooped byte
        bite = uart_boot_byte;
    endtask

    task automatic uart_boot_scoop_expect(input string name, input byte_bt exp);
        byte_bt bite;
        uart_boot_scoop(bite);
        if (bite != exp)
            $fatal(1, "[UART] Expected %s (%0x) after read command, received %0x", name, exp, bite);
    endtask

    initial 
    begin
        static byte_bt uart_read_buf [$];
        byte_bt bite;
        wait_for_reset();
        forever 
        begin
          uart_read_byte(bite);
          if (uart_boot_ena) 
          begin
            uart_boot_byte  = bite;
            uart_boot_ena = 0;
          end 
          else if (bite == "\n") 
          begin
            $display("[UART] %s", {>>8{uart_read_buf}});
            uart_read_buf.delete();
          end 
          else if (bite == UartDebugEoc) 
          begin
            uart_boot_eoc = 1;
          end 
          else 
          begin
            $display("[UART] %h", bite);
            uart_read_buf.push_back(bite);
          end
        end
    end

    task automatic uart_debug_rw(word_bt addr, word_bt len_or_w, ref byte_bt data [$]);
        byte_bt bite;
        word_bt len = len_or_w ? len_or_w : data.size();
        // Send command, address, and length
        uart_write_byte(len_or_w ? UartDebugCmdRead : UartDebugCmdWrite);
        for (int i = 0; i < 4; ++i)
            uart_write_byte(addr[8*i +: 8]);
        for (int i = 0; i < 4; ++i)
            uart_write_byte(len[8*i +: 8]);
        // Receive and check ACK
        uart_boot_scoop_expect("ACK", UartDebugAck);
        // Send or receive requested data
        for (int i = 0; i < len; ++i) 
        begin
            if (len_or_w) 
            begin
                uart_boot_scoop(bite);
                data.push_back(bite);
            end 
            else 
            begin
                uart_write_byte(data[i]);
            end
        end
        // Receive and check EOT
        uart_boot_scoop_expect("EOT", UartDebugEot);
    endtask

    task automatic uart_debug_elf_preload(input string binary, output word_bt entry);
        int sec_addr, sec_len;
        $display("[UART] Preloading ELF binary: %s", binary);
        if (read_elf(binary))
        $fatal(1, "[UART] Failed to load ELF!");
        while (get_section(sec_addr, sec_len)) 
        begin
            byte bf[] = new [sec_len];
            $display("[UART] Preloading section at 0x%h (%0d bytes)", sec_addr, sec_len);
            if (read_section(sec_addr, bf, sec_len)) $fatal(1, "[UART] Failed to read ELF section!");
            // Write section in blocks
            for (int i = 0; i <= sec_len ; i += UartBurstBytes) 
            begin
                byte_bt bytes [$];
                if (i != 0)
                $display("[UART] - %0d/%0d bytes (%0d%%)", i, sec_len, i*100/(sec_len>1 ? sec_len-1 : 1));
                for (int b = 0; b < UartBurstBytes; b++) 
                begin
                    if (i+b >= sec_len) break;
                    bytes.push_back(bf [i+b]);
                end
                uart_debug_rw(sec_addr + i, 0, bytes);
            end
        end
        void'(get_entry(entry));
        $display("[UART] Preload complete");
    endtask

    task automatic uart_debug_elf_run_and_wait(input string binary);
        byte_bt bite;
        word_bt entry;
        // Wait some time for boot ROM to settle (No way to query this using only UART)
        $display("[UART] Waiting for debug loop to start");
        #(500*UartBaudPeriod);
        // We send an ACK challenge to the debug server and wait for an ACK response
        $display("[UART] Sending ACK chellenge");
        uart_write_byte(UartDebugAck);
        uart_boot_scoop_expect("ACK", UartDebugAck);
        $display("[UART] Receiving ACK chellenge");
        // Preload
        uart_debug_elf_preload(binary, entry);
        $display("[UART] Binary uploaded");
        $display("[UART] Go to user_code");
        uart_write_byte(UartDebugCmdExec);
     endtask


    task automatic uart_test_write_read(input byte_bt write_data, output byte_bt read_data);
        // Escriu el byte per la UART
        uart_write_byte(write_data);     

        // Llegeix el byte de la UART
        uart_read_byte(read_data);
        
        // Comprova si el byte llegit és igual al byte escrit
        
        // Comprova si el byte llegit és igual al byte escrit
        if (read_data !== write_data) begin
            $display("[ERROR] Mismatch: wrote %h, but read %h", write_data, read_data);
        end else begin
            $display("[SUCCESS] Correctly wrote and read %h", write_data);
        end

    endtask //automatic uart_test_write_read 

    // READ CSR
    task automatic read_csr(input [11:0] csr_address, output [63:0] csr_data);
        begin
            // Configurar los controles para realizar la lectura del CSR
            ctrl_en <= 1'b1;
            ctrl_op <= 1'b0;  // Supongamos que 1'b0 es para operaciones de lectura
            ctrl_addr <= {52'b0, csr_address}; // Asume que la dirección del CSR es los 12 bits menos significativos

            // Esperar a que la operación se complete
            @(posedge ctrl_ready);

            // Leer el valor del CSR
            csr_data = ctrl_write_data;

            // Deshabilitar los controles
            ctrl_en <= 1'b0;
        end
    endtask

    // Señales del DUT (Device Under Test) MMU
    //logic clk;
    //logic rstn;
    logic [43:0] satp_ppn;
    logic [38:0] v_addr;
    logic [3:0] g_pte;
    logic [55:0] p_addr;
    logic ready_petition;

     // Instanciación del DUT
    mmu_top dut (
        .clk_i(CLK),
        .rstn_i(RESET),
        .ready_petition(ready_petition),
        .satp_ppn(satp_ppn),
        .v_addr(v_addr),
        .g_pte(g_pte),
        .p_addr(p_addr)
    );



    always #5 CLK = ~CLK; // 15
    
    initial
    begin
         
        
        
        if (!$value$plusargs("BOOTMODE=%d", axi_gpio_i))     axi_gpio_i     = 0;
        if (!$value$plusargs("BINARY=%s",   preload_elf))   preload_elf   = "";

        
        
        // Inicializar señales
        CLK = 0;
        RESET = 0;
        ready_petition <= 0;
        satp_ppn = 44'b0;
        v_addr = 39'b0;
        g_pte = 4'b0;

        // Aplicar reset
        #10 RESET = 1;

        // Test 1: Primera dirección de entrada
        ready_petition = 1;
        #30;
        satp_ppn = 44'h1A3;     // Ejemplo de PPN raíz
        v_addr = 39'h12345678;  // Dirección virtual de prueba
        g_pte = 4'b1111;        // PTE con todos los flags

        // Esperar unos ciclos de reloj para observar el resultado
        #50;
        //ready_petition <= 0;

        // Comprobar la salida
        if (p_addr != 56'h0000D1A345678) begin
            $display("Test 1 Fallido. Dirección física esperada: 0x0000D1A345678, dirección física obtenida: 0x%0h", p_addr);
        end else begin
            $display("Test 1 Pasado.");
        end
        
        // Resetear la señal ready_petition
        ready_petition = 0;


        // Test 2: Segunda dirección de entrada
        #10;
        ready_petition <= 1;
        satp_ppn = 44'h3F7;     // Otro ejemplo de PPN raíz
        v_addr = 39'h89ABCDEF;  // Otra dirección virtual de prueba
        g_pte = 4'b0111;        // PTE con algunos flags

        // Esperar unos ciclos de reloj para observar el resultado
        #50;

        // Comprobar la salida
        if (p_addr != 56'h0001FC789BCDEF) begin
            $display("Test 2 Fallido. Dirección física esperada: 0x0001FC789BCDEF, dirección física obtenida: 0x%0h", p_addr);
        end else begin
            $display("Test 2 Pasado.");
        end

        // Resetear la señal ready_petition
        ready_petition = 0;

        // Finalizar la simulación
        #50;
        $finish;



    end
endmodule